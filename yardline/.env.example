# No configuration needed for the local, explicitly labeled demo.
PERSISTENCE=sqlite
DATABASE_PATH=./data/yardline.sqlite
# Production: PERSISTENCE=postgres, AUTH_MODE=supabase, DEMO_SEED=false
# Supabase: use the transaction pooler URL or a direct Postgres connection.
# DATABASE_URL=postgresql://...
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# AUTH_MODE=supabase
# DEMO_SEED=false
