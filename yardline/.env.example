# No configuration needed for the local, explicitly labeled demo.
PERSISTENCE=sqlite
DATABASE_PATH=./data/yardline.sqlite
# Production: PERSISTENCE=postgres, AUTH_MODE=supabase, DEMO_SEED=false
# Supabase: use the transaction pooler URL or a direct Postgres connection.
# DATABASE_URL=postgresql://...
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# AUTH_MODE=supabase
# DEMO_SEED=false
# Netlify supplies NETLIFY_DB_URL for its managed PostgreSQL database.
# Password-protect a hosted demonstration (keep credentials in server-only settings):
# YARDLINE_REQUIRE_ACCESS_GATE=true
# YARDLINE_ACCESS_USERNAME=your-demo-username
# YARDLINE_ACCESS_PASSWORD=your-strong-random-password
