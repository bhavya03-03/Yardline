{
  "name": "yardline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-ocr.mjs",
    "predev": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "tsx scripts/database.ts setup",
    "db:seed": "tsx scripts/database.ts seed",
    "db:provision": "tsx scripts/provision.ts",
    "db:reset": "tsx scripts/database.ts reset --confirm-demo-reset",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
